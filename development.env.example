# @xeplr/workflow-api — running on its own (npm run start-api).
#
# Copy to development.env and fill in. development.env is never committed: it
# holds keys, secrets and database logins. Every value below is a placeholder.
# A host that EMBEDS workflow (registerWorkflow) does not use this file — see
# "Embedded" in README.md.

NODE_ENV=development
LOG_DIR=./logs
WORKFLOW_PORT=19122

# This package's database, and the server login (encrypted — npm run db:encrypt).
DB_API=xeplr_workflow
WORKFLOW_CONNECTION=

# Decrypts every stored connection. Generate one; never reuse another app's.
ENCRYPTION_KEY=

# The sign-in service this API checks tokens against, and its database.
AUTH_URL=http://localhost:19101
AUTH_PORT=19101
AUTH_DB_NAME=xeplr_auth
AUTH_DB_CONNECTION_INFO_ENCRYPTED=
AUTH_JWT_SECRET=
AUTH_ACTIVATION_BASE_URL=http://localhost:19120/auth/activate
AUTH_SUPER_ADMIN_EMAIL=admin@example.com
AUTH_SUPER_ADMIN_PASSWORD=
# Workflow's access rules load into the sign-in service after its own:
XEPLR_AUTH_MIGRATIONS=./migrations-auth

# The shared control-plane database (xeplr_configs).
XCFG_DB_NAME=xeplr_configs
# The root of all data, absolute and existing: a step's files are in
# <root>/<app>/<company>/<workspace>/ under it (@xeplr/actions).
XEPLR_DATA_DIR=
XCFG_DB_CONNECTION_INFO_ENCRYPTED=

# Mail (invites, and templated email steps).
EMAIL_DB_NAME=xeplr_workflow_email
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Exact env var names a step may read as {env.NAME}. Empty = none.
WORKFLOW_ENV_EXPOSED=
# Only for steps that call out and wait (job-run):
# WORKFLOW_PUBLIC_URL=http://localhost:19122
# JOBS_API_URL=http://localhost:19102/jobs
